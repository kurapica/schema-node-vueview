{
  "name": "schema-node-vue-view",
  "version": "1.0.0",
  "description": "Reusable Vue 3 components for visualizing schema-node data using Element Plus.",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.8",
    "vue": "^3.5.24"
  },
  "keywords": [
    "vue",
    "element-plus",
    "schema",
    "ui",
    "component",
    "visualization"
  ],
  "author": "kurapica125@outlook.com",
  "license": "Apache License 2.0",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "sass-embedded": "^1.89.0",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^2.2.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kurapica/schema-node-vue-view.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "less": "^4.5.1",
    "schema-node-core": "workspace:*",
    "schema-node-app": "workspace:*"
  }
}
